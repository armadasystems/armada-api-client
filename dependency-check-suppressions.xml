<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        CVE-2025-15104 (CVSS 6.9 MEDIUM) - hibernate-validator 8.0.x
        No fixed version available in the 8.0.x line.
        hibernate-validator 9.x requires Jakarta EE 11, incompatible with Spring Boot 3.x (Jakarta EE 10).
        Accepted risk: Spring Boot 3.x will provide an upgrade path when a patch is available.
        Review: revisit when Spring Boot 3.5+ ships or a hibernate-validator 8.0.4+ is released.
    -->
    <suppress>
        <notes>CVE-2025-15104 affects all hibernate-validator 8.0.x versions. No patched 8.0.x available.
        9.x requires Jakarta EE 11 which is incompatible with Spring Boot 3.x. Accepted risk.</notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate\-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!--
        CVE-2026-22735 (LOW) - spring-webflux and spring-webmvc 6.2.x
        Fix requires Spring Framework 7.0.6 which requires Spring Boot 4.x (Jakarta EE 11).
        Spring Boot 3.x is bound to Spring Framework 6.x (Jakarta EE 10).
        Accepted risk: LOW severity; revisit when Spring Boot 4.x / Spring Framework 7.x migration is planned.
    -->
    <suppress>
        <notes>CVE-2026-22735 LOW. Fix requires Spring Framework 7.0.6 (Spring Boot 4.x / Jakarta EE 11),
        incompatible with current Spring Boot 3.x stack. Accepted risk.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring\-webflux@.*$</packageUrl>
        <cve>CVE-2026-22735</cve>
    </suppress>

    <suppress>
        <notes>CVE-2026-22735 LOW. Fix requires Spring Framework 7.0.6 (Spring Boot 4.x / Jakarta EE 11),
        incompatible with current Spring Boot 3.x stack. Accepted risk.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring\-webmvc@.*$</packageUrl>
        <cve>CVE-2026-22735</cve>
    </suppress>

    <!--
        CVE-2026-42577 (HIGH) - io.netty:netty-transport-native-epoll 4.1.133.Final
        Fix requires 4.2.13.Final. Upgrading only the native classifier artifact to 4.2.x
        while Netty core remains at 4.1.x risks a JNI ABI mismatch at runtime on Linux.
        A full Netty 4.2.x migration (tied to a reactor-netty compatibility upgrade) is needed.
        Accepted risk pending a reactor-netty release that supports Netty 4.2.x.
    -->
    <suppress>
        <notes>CVE-2026-42577 HIGH. Fix requires netty 4.2.13.Final; no 4.1.x backport available.
        Upgrading only the native epoll artifact risks ABI mismatch with Netty 4.1.x core.
        Accepted risk pending full Netty 4.2.x / reactor-netty migration.</notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/netty\-transport\-native\-epoll@.*$</packageUrl>
        <cve>CVE-2026-42577</cve>
    </suppress>

    <!--
        CVE-2026-42584 (HIGH) - tomcat-embed-core: unsafe reuse of socket after HTTP parsing failure.
        10.1.54 is the latest available 10.1.x in Maven Central and does not fix this CVE.
        The 9.0.x branch fix is 9.0.117; no patched 10.1.x version is published yet.
        Accepted risk: upgrade as soon as a patched 10.1.x is released.
        Review: check for tomcat-embed-core 10.1.55+ in Maven Central.
    -->
    <suppress>
        <notes>CVE-2026-42584 HIGH. Unsafe socket reuse after HTTP parsing failure.
        No patched 10.1.x available in Maven Central (latest is 10.1.54).
        9.0.117 is the 9.0.x fix. Accepted risk pending 10.1.55+ release.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat\-embed\-core@.*$</packageUrl>
        <cve>CVE-2026-42584</cve>
    </suppress>

</suppressions>
